# Source-code-only repository: ignore everything by default.
*

# Allow directory traversal and source/project documentation.
!*/
!*.py
!.gitignore
!README.md
!requirements.txt

# Never include environments, caches, nested repositories, or generated data.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
datascrape_project/Limeox/

# Explicit data and generated-artifact exclusions.
*.csv
*.csv.gz
*.xlsx
*.xls
*.parquet
*.json
*.pkl
*.joblib
*.png
*.jpg
*.jpeg
*.ipynb
*.log
